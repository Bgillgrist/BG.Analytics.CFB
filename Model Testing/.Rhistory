)
# -----------------------------
# LOAD DATA
# -----------------------------
df <- read.csv("rankings_projection_weekly_2025.csv")
# -----------------------------
# CHOOSE TEAM
# -----------------------------
selected_team <- "South Carolina"      # <-- CHANGE TEAM HERE
team_color <- "darkred"         # <-- CHANGE HEX COLOR HERE
# -----------------------------
# FILTER DATA
# -----------------------------
team_df <- df %>%
filter(team == selected_team)
# -----------------------------
# CREATE PLOT
# -----------------------------
ggplot(team_df, aes(x = week)) +
# ACTUAL AP RANKING (SOLID)
geom_line(
aes(
y = actual_ap_ranking,
linetype = "Actual AP Ranking"
),
linewidth = 1.5,
color = team_color
) +
# PROJECTED AP RANKING (DASHED)
geom_line(
aes(
y = projected_ap_ranking,
linetype = "Projected AP Ranking"
),
linewidth = 1.5,
color = team_color
) +
# POINTS FOR ACTUAL
geom_point(
aes(y = actual_ap_ranking),
size = 3,
color = team_color
) +
# POINTS FOR PROJECTED
geom_point(
aes(y = projected_ap_ranking),
size = 3,
shape = 1,
color = team_color
) +
# LINE TYPES
scale_linetype_manual(
values = c(
"Actual AP Ranking" = "solid",
"Projected AP Ranking" = "dashed"
)
) +
# REVERSE RANK AXIS
scale_y_reverse(breaks = 1:25) +
scale_x_continuous(
breaks = sort(unique(team_df$week))
) +
labs(
title = paste("2025", selected_team, "Projected vs Actual AP Rankings"),
subtitle = "Solid = Actual AP | Dashed = Projected AP",
x = "Week",
y = "AP Ranking",
linetype = ""
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold"),
legend.position = "top"
)
